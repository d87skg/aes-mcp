{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aesprotocol.org/schemas/risk-vector-v0.1.json",
  "title": "AES Risk Vector Schema v0.1",
  "description": "Canonical machine-readable schema for AI Agent risk attestation. FROZEN.",
  "type": "object",
  "required": ["trace_id", "timestamp", "aes_score", "risk_vector", "adj_er", "attestation"],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Unique identifier of the trace session"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier of the Agent under assessment"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp of attestation generation"
    },
    "aes_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "AES behavioral credit score (V0.1.1 Frozen)"
    },
    "aes_level": {
      "type": "string",
      "enum": ["AAA", "AA", "A", "BBB", "BB", "DANGER"],
      "description": "AES credit rating level"
    },
    "risk_vector": {
      "type": "object",
      "required": ["stability", "contagion", "decay", "containment"],
      "properties": {
        "stability": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1000 },
            "level": { "type": "string", "enum": ["AAA", "AA", "A", "BBB", "BB", "DANGER"] }
          },
          "description": "Behavioral stability — constraint integrity + drift resistance"
        },
        "contagion": {
          "type": "object",
          "required": ["band"],
          "properties": {
            "cpf_raw": { "type": "number", "minimum": 0 },
            "cpf_scaled": { "type": "number", "minimum": 0 },
            "band": { "type": "string", "enum": ["LOCAL", "ELEVATED", "PRECURSOR", "SYSTEMIC"] }
          },
          "description": "Systemic contagion potential — propagation depth x breadth x amplification"
        },
        "decay": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "led_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
          },
          "description": "Chronic economic decay — retry storm, API burn, resource leak, latent degradation"
        },
        "containment": {
          "type": "object",
          "required": ["score"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "blast_radius": { "type": "number", "minimum": 0, "maximum": 1 },
            "circuit_breaker_triggered": { "type": "boolean" },
            "circuit_breaker_success": { "type": "boolean" }
          },
          "description": "Isolation capability — blast radius limitation and circuit breaker effectiveness"
        }
      },
      "description": "Four-dimensional risk state. Must not be collapsed to scalar."
    },
    "adj_er": {
      "type": "number",
      "minimum": 0,
      "description": "Adjusted Economic Reliability penalty — piecewise coupled from RiskVector"
    },
    "er_detail": {
      "type": "object",
      "properties": {
        "explicit_loss": { "type": "number" },
        "implicit_loss": { "type": "number" },
        "effective_loss": { "type": "number" },
        "cpf_multiplier": { "type": "number" },
        "led_multiplier": { "type": "number" },
        "containment_effective": { "type": "number" },
        "formula": { "type": "string" }
      },
      "description": "Transparent breakdown of ER penalty calculation"
    },
    "attestation": {
      "type": "object",
      "required": ["oracle_version", "risk_vector_hash", "trace_root", "timestamp", "signer"],
      "properties": {
        "oracle_version": { "type": "string" },
        "risk_vector_hash": { "type": "string", "description": "Keccak256 of canonical RiskVector JSON" },
        "trace_root": { "type": "string", "description": "Merkle root of trace events" },
        "timestamp": { "type": "integer", "description": "Unix timestamp of signing" },
        "signer": { "type": "string", "description": "Oracle node identifier or public key" },
        "signature": { "type": "string", "description": "Cryptographic signature over attestation payload" }
      },
      "description": "Cryptographic proof that this risk state was observed at a specific time"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "spec_version": { "type": "string" },
        "engine_versions": {
          "type": "object",
          "properties": {
            "aes_scorer": { "type": "string" },
            "drift_engine": { "type": "string" },
            "cpf_engine": { "type": "string" },
            "ese_engine": { "type": "string" },
            "containment_engine": { "type": "string" }
          }
        },
        "golden_trace_match": { "type": "boolean" },
        "death_mode_archetype": {
          "type": "string",
          "enum": ["isolated_acute", "coordination_instability", "chronic_decay", "systemic_collapse", "healthy"]
        }
      }
    }
  }
}